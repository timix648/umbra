
module UmbraSwap where

import DA.Date (date, Month(..))
import DA.Time (time, addRelTime, minutes)
import DA.List (find)
import DA.Optional (isSome, fromOptional)
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationRequestV1
import qualified DA.TextMap as TextMap

-- ============================================================================
-- UMBRA SWAP -- the unified any-to-any settlement engine.
--
-- One asset model, one allocation, one swap path. cBTC, cETH and CC are all
-- ordinary CIP-56 assets identified by (admin, assetId); the engine never
-- special-cases any of them. A trade swaps leg A for leg B where each leg is
-- an arbitrary asset, so cBTC<->cETH, cBTC<->CC and cETH<->CC all fall out of
-- the same code with no per-asset branches.
--
-- Design decisions (locked):
--   * New file -- the legacy Umbra.daml / UmbraDvP.daml paths are left intact
--     until this engine is proven green, then retired.
--   * The RFQ layer is generalised too: a request names the asset it OFFERS
--     and the asset it WANTS, and a dealer quotes a price in the wanted asset.
--   * The set of tradeable assets lives on-ledger in an AssetRegistry, not in
--     backend config.
-- ============================================================================


-- ----------------------------------------------------------------------------
-- Asset identity
-- ----------------------------------------------------------------------------
-- An asset is fully described by its issuing/administering party plus a symbol.
-- Two holdings are fungible iff their (admin, symbol) match.
data AssetId = AssetId
  with
    admin  : Party    -- issuer (cBTC/cETH issuer) or registry/admin (CC)
    symbol : Text     -- "cBTC", "cETH", "CC"
  deriving (Eq, Show, Ord)


-- ----------------------------------------------------------------------------
-- On-ledger asset registry
-- ----------------------------------------------------------------------------
-- The venue operator curates which assets are tradeable. Kept on-ledger so the
-- valid asset set is auditable and not a hidden backend constant. Listing an
-- asset is operator-authorised; the registry is observable by all participants
-- so any party can validate an RFQ's assets against it.
template AssetRegistry
  with
    operator     : Party
    participants : [Party]        -- who can see the registry (dealers, requesters)
    assets       : [AssetId]      -- the tradeable set
  where
    signatory operator
    observer participants

    -- List (or re-list) an asset. Idempotent: re-listing an existing asset is
    -- a no-op rather than a duplicate.
    choice ListAsset : ContractId AssetRegistry
      with
        asset : AssetId
      controller operator
      do
        let assets' = if asset `elem` assets then assets else asset :: assets
        create this with assets = assets'

    choice DelistAsset : ContractId AssetRegistry
      with
        asset : AssetId
      controller operator
      do create this with assets = filter (/= asset) assets

    -- Add/remove a participant who may observe the registry.
    choice SetParticipants : ContractId AssetRegistry
      with
        participants' : [Party]
      controller operator
      do create this with participants = participants'

    -- Read-only helper: assert an asset is currently listed.
    nonconsuming choice RequireListed : ()
      with
        asset : AssetId
      controller operator
      do assertMsg ("asset not listed: " <> asset.symbol) (asset `elem` assets)


-- ----------------------------------------------------------------------------
-- Unified asset holding
-- ----------------------------------------------------------------------------
-- Replaces CashHolding and InstrumentHolding with a single generic holding.
-- Implements the CIP-56 Holding interface so wallets and the allocation
-- machinery treat cBTC, cETH and CC identically.
template AssetHolding
  with
    owner  : Party
    asset  : AssetId
    amount : Decimal
  where
    signatory owner
    observer asset.admin
    ensure amount > 0.0

    -- CIP-56: expose as a standard, wallet-discoverable Holding.
    interface instance Holding for AssetHolding where
      view = HoldingView with
        owner
        instrumentId = InstrumentId with admin = asset.admin, id = asset.symbol
        amount
        lock = None
        meta = emptyMetadata


-- ----------------------------------------------------------------------------
-- Unified allocation (one template for every asset)
-- ----------------------------------------------------------------------------
-- A single AssetAllocation replaces CashAllocation + InstrumentAllocation.
-- signatory = sender, so each party commits its own leg under its own
-- authority; the operator never forges. Executing the allocation moves the
-- committed amount sender -> receiver and returns any change to the sender.
mkSpec : Party -> Party -> Party -> Decimal -> AssetId -> Text -> AllocationSpecification
mkSpec executor sender receiver amount asset legId =
  let settlement = SettlementInfo with
        executor
        settlementRef = Reference with id = "umbra-swap", cid = None
        requestedAt = epoch
        allocateBefore = epoch
        settleBefore = epoch
        meta = emptyMetadata
      leg = TransferLeg with
        sender; receiver; amount
        instrumentId = InstrumentId with admin = asset.admin, id = asset.symbol
        meta = emptyMetadata
  in AllocationSpecification with settlement; transferLegId = legId; transferLeg = leg

-- Fixed epoch; deadlines are not enforced by this flow, and a constant keeps
-- mkSpec pure (no getTime inside `view`).
epoch : Time
epoch = time (date 1970 Jan 1) 0 0 0

template AssetAllocation
  with
    sender     : Party
    receiver   : Party
    executor   : Party
    asset      : AssetId
    amount     : Decimal
    holdingCid : ContractId AssetHolding   -- the sender's holding backing this leg
    legId      : Text
  where
    signatory sender
    observer receiver, executor, asset.admin

    interface instance Allocation for AssetAllocation where
      view = AllocationView with
        allocation = mkSpec executor sender receiver amount asset legId
        holdingCids = [toInterfaceContractId @Holding holdingCid]
        meta = emptyMetadata

      allocation_executeTransferImpl _self _arg = do
        h <- fetch holdingCid
        assertMsg "allocation sender is not the holding owner" (h.owner == sender)
        assertMsg "asset mismatch on allocation" (h.asset == asset)
        assertMsg ("insufficient " <> asset.symbol) (h.amount >= amount)
        archive holdingCid
        recvCid <- create AssetHolding with
          owner = receiver; asset; amount
        changeCids <-
          if h.amount > amount
            then do
              c <- create AssetHolding with
                owner = sender; asset; amount = h.amount - amount
              pure [toInterfaceContractId @Holding c]
            else pure []
        pure Allocation_ExecuteTransferResult with
          senderHoldingCids = changeCids
          receiverHoldingCids = [toInterfaceContractId @Holding recvCid]
          meta = emptyMetadata

      -- Sender may withdraw an unexecuted allocation; the backing holding
      -- returns to the sender.
      allocation_withdrawImpl _self _arg =
        pure Allocation_WithdrawResult with
          senderHoldingCids = [toInterfaceContractId @Holding holdingCid]
          meta = emptyMetadata

      allocation_cancelImpl _self _arg =
        pure Allocation_CancelResult with
          senderHoldingCids = [toInterfaceContractId @Holding holdingCid]
          meta = emptyMetadata


-- ----------------------------------------------------------------------------
-- Generalised RFQ layer
-- ----------------------------------------------------------------------------
-- A request advertises: "I will give `offerAmount` of `offerAsset`, and I want
-- `wantAsset` in return." Dealers quote a `price` denominated in wantAsset
-- (total wantAsset they will pay for the whole offer). Lower price = cheaper
-- for whoever is buying; the requester picks the best quote. Both assets are
-- validated against the AssetRegistry when the RFQ is created.
template SwapRfq
  with
    requester   : Party
    operator    : Party
    offerAsset  : AssetId       -- what the requester provides
    offerAmount : Decimal
    wantAsset   : AssetId       -- what the requester wants in return
    invited     : [Party]       -- dealers who may quote
    expiresAt   : Time          -- dealers may not quote after this
  where
    signatory requester
    observer operator, invited
    ensure offerAmount > 0.0 && offerAsset /= wantAsset

    -- Invite a dealer to quote (creates a private invitation visible only to
    -- that dealer and the requester).
    nonconsuming choice InviteDealer : ContractId SwapInvitation
      with
        dealer : Party
      controller requester
      do
        -- `invited` is the allowlist fixed when the RFQ was created; this choice only
        -- materialises the invitation for someone already on it. The message must
        -- describe the FAILING case (dealer absent), not the passing one.
        assertMsg "dealer is not on this RFQ's invite list" (dealer `elem` invited)
        -- `self` is this SwapRfq's own contract id. Threading it down the chain
        -- means a quote can be attributed to the request it answers -- exactly,
        -- not by guessing from matching amounts.
        create SwapInvitation with
          requester; operator; dealer
          offerAsset; offerAmount; wantAsset; expiresAt
          rfqCid = self

    -- Invite every dealer on the allowlist in ONE transaction.
    --
    -- InviteDealer needs this contract's own cid, which does not exist until the create
    -- has committed -- so inviting N dealers took N separate signatures on top of the
    -- create. At two dealers that is a wrinkle; at a hundred it is 101 wallet prompts to
    -- open one request, which is not a flow anyone would use.
    --
    -- Submitted as a CreateAndExerciseCommand, this collapses the whole opening move to
    -- a single signature. It grants nothing extra: the dealers are the ones already
    -- named in , and InviteDealer remains for adding one later.
    nonconsuming choice InviteAll : [ContractId SwapInvitation]
      controller requester
      do
        forA invited (\d ->
          create SwapInvitation with
            requester; operator; dealer = d
            offerAsset; offerAmount; wantAsset; expiresAt
            rfqCid = self)

    choice CancelRfq : ()
      controller requester
      do pure ()


-- A private, per-dealer invitation. Only the requester and this dealer are
-- stakeholders, so no dealer can observe another's invitation or quote.
template SwapInvitation
  with
    requester   : Party
    operator    : Party
    dealer      : Party
    offerAsset  : AssetId
    offerAmount : Decimal
    wantAsset   : AssetId
    expiresAt   : Time
    rfqCid      : ContractId SwapRfq   -- the request this invitation answers
  where
    signatory requester
    observer dealer

    -- The dealer responds with a price (total wantAsset for the whole offer).
    -- The dealer prices the request. A quote submitted after the RFQ has
    -- expired is refused by the ledger itself, not merely hidden by the UI.
    -- `validUntil` is how long this dealer's price stays firm.
    choice SubmitSwapQuote : ContractId SwapQuote
      with
        price      : Decimal
        validUntil : Time
      controller dealer
      do
        now <- getTime
        -- The invitation is its own contract and outlives CancelRfq, so without this
        -- a dealer could still price a request the buyer had already withdrawn. An
        -- invited dealer is an observer on the SwapRfq, so it may fetch it; once the
        -- buyer cancels, the RFQ is archived and this fetch fails.
        _ <- fetch rfqCid
        assertMsg "price must be positive" (price > 0.0)
        assertMsg "this request has expired" (now < expiresAt)
        assertMsg "quote validity must be in the future" (validUntil > now)
        create SwapQuote with
          requester; operator; dealer
          offerAsset; offerAmount; wantAsset; price; validUntil
          rfqCid

    choice DeclineInvitation : ()
      controller dealer
      do pure ()


-- A dealer's private quote. Signed by the dealer, visible only to the
-- requester -- the ledger itself withholds it from rival dealers (P1).
template SwapQuote
  with
    requester   : Party
    operator    : Party
    dealer      : Party
    offerAsset  : AssetId
    offerAmount : Decimal
    wantAsset   : AssetId
    price       : Decimal     -- total wantAsset the dealer pays for the offer
    validUntil  : Time        -- the dealer's price is firm until this moment
    rfqCid      : ContractId SwapRfq   -- the request this quote answers
  where
    signatory dealer
    observer requester

    -- The requester accepts. This kicks off the two-leg swap:
    --   * requester gives offerAmount of offerAsset  -> dealer
    --   * dealer gives price of wantAsset            -> requester
    -- Each side supplies its own backing holding; both legs settle atomically.
    choice AcceptSwapQuote : ContractId SwapProposal
      with
        -- Supplied by the venue when it builds this command. Optional so a pre-0.3.0
        -- caller still type-checks, and so a fee-free venue stays possible.
        venueFeeParty  : Optional Party
        venueFeeAmount : Optional Decimal
      controller requester
      do
        now <- getTime
        -- Cancelling must actually cancel. A quote outlives the request it answers, and
        -- this choice previously checked only firmness -- so a buyer who withdrew a
        -- request could still be shown a liftable price against it. The requester is
        -- the SwapRfq's signatory, so this fetch succeeds while the request is live and
        -- fails once CancelRfq has archived it.
        _ <- fetch rfqCid
        assertMsg "this quote is no longer firm" (now < validUntil)
        create SwapProposal with
          requester; operator; dealer
          offerAsset; offerAmount
          wantAsset; price
          -- 15/30 minutes mirrors the window the backend already requests when it
          -- allocates a real leg, so the on-ledger view and the registry agree.
          requestedAt = Some now
          allocateBefore = Some (addRelTime now (minutes 15))
          settleBefore = Some (addRelTime now (minutes 30))
          -- Unique per acceptance: the pair alone collided across every trade of
          -- that pair, which is exactly what a settlement reference must not do.
          tradeId = Some (offerAsset.symbol <> "/" <> wantAsset.symbol <> "@" <> show now)
          feeParty = venueFeeParty
          feeAmount = venueFeeAmount


-- ----------------------------------------------------------------------------
-- Two-leg atomic swap choreography
-- ----------------------------------------------------------------------------
-- The authority to fire both legs' Allocation_ExecuteTransfer must be gathered
-- onto a single jointly-signed contract. We reuse the proven propose/accept
-- pattern, generalised so BOTH legs are arbitrary AssetAllocations.
template SwapProposal
  with
    requester   : Party
    operator    : Party
    dealer      : Party
    offerAsset  : AssetId
    offerAmount : Decimal
    wantAsset   : AssetId
    price       : Decimal
    -- Settlement window and identity. These exist so the CIP-56 AllocationRequest
    -- view below can report the REAL deadlines and a unique reference: an interface
    -- view is a pure function of the payload, so it cannot read ledger time itself.
    -- Without these the view could only report invented constants, which a wallet
    -- would render as a settlement with no deadline.
    --
    -- Optional because Daml smart-contract upgrades only admit new fields that are
    -- Optional; making them mandatory made 0.2.0 an illegal upgrade of the already
    -- vetted 0.1.0 ("added new fields, but those fields are not Optional"). Every
    -- proposal created by this version sets them; only pre-upgrade contracts are None.
    requestedAt    : Optional Time   -- when the requester accepted the quote
    allocateBefore : Optional Time   -- both legs must be allocated by this moment
    settleBefore   : Optional Time   -- the swap must settle by this moment
    tradeId        : Optional Text   -- unique per accepted quote; the settlement reference
    -- The venue fee, fixed the moment the quote is lifted. It rides on the proposal so
    -- the dealer can read the exact amount BEFORE it signs anything -- a fee introduced
    -- later, after commitment, would be a fee nobody agreed to.
    -- Borne by the winning dealer and denominated in the WANT asset, which is how
    -- institutional RFQ venues charge: the liquidity provider pays for the flow.
    -- Optional for the same upgrade reason as the fields above.
    feeParty       : Optional Party    -- who collects it
    feeAmount      : Optional Decimal  -- in the want asset, paid by the dealer
  where
    signatory requester
    observer dealer, operator

    -- Requester commits its offer leg and hands off to the dealer.
    choice CommitRequesterLeg : ContractId SwapDealerPending
      with
        requesterHoldingCid : ContractId AssetHolding
      controller requester
      do
        offerAllocRaw <- create AssetAllocation with
          sender = requester; receiver = dealer; executor = operator
          asset = offerAsset; amount = offerAmount
          holdingCid = requesterHoldingCid; legId = "offer-leg"
        create SwapDealerPending with
          requester; operator; dealer
          offerAsset; offerAmount; wantAsset; price
          offerAllocCid = toInterfaceContractId @Allocation offerAllocRaw

    -- v6 REAL path: the backend has already allocated BOTH legs against the real
    -- registry (creating two DvpLegAllocation contracts) and is about to execute
    -- them atomically via /api/real/settle. This choice records the trade on-ledger
    -- as the blind-auction result, pointing at the two real allocations for audit.
    -- Both principals authorize (matching SwapSettlement's signatories). No holdings
    -- are moved here -- execution is the backend's atomic registry call.
    choice RecordRealSwap : ContractId SwapSettlement
      with
        realOfferAllocCid : ContractId Allocation
        realWantAllocCid  : ContractId Allocation
        realRefMid        : Optional Decimal
        realFeeAllocCid   : Optional (ContractId Allocation)
      controller requester, dealer
      do
        create SwapSettlement with
          requester; operator; dealer
          offerAsset; offerAmount; wantAsset; price
          refMid = realRefMid
          offerAllocCid = realOfferAllocCid
          wantAllocCid = realWantAllocCid
          feeParty; feeAmount
          feeAllocCid = realFeeAllocCid
          settledVia = "real"

    -- SIGNED-MODE path: single-party propose/accept so no step needs two signers
    -- at once (interactive-submission supports only single-party submissions).
    -- Requester proposes (requester-signed); dealer accepts (dealer-signed) ->
    -- SwapSettlement with both authorities, identical to RecordRealSwap's result.
    choice ProposeRealSwap : ContractId RealSwapPending
      with
        realOfferAllocCid : ContractId Allocation
        realWantAllocCid  : ContractId Allocation
        realRefMid        : Optional Decimal
        -- The dealer allocates this one too, at the same time as its want leg.
        realFeeAllocCid   : Optional (ContractId Allocation)
      controller requester
      do
        create RealSwapPending with
          requester; operator; dealer
          offerAsset; offerAmount; wantAsset; price
          offerAllocCid = realOfferAllocCid
          wantAllocCid = realWantAllocCid
          refMid = realRefMid
          feeParty; feeAmount
          feeAllocCid = realFeeAllocCid


-- A requester-signed proposal to settle a real swap. The dealer accepts to gather
-- its authority onto the SwapSettlement -- the propose/accept equivalent of the
-- two-party RecordRealSwap, but as two single-party transactions.
    -- CIP-56 AllocationRequest (Trojan Horse): a standard Canton wallet reads this view
    -- and prompts each sender to allocate their leg -- no custom-DAR vetting needed.
    interface instance AllocationRequest for SwapProposal where
      allocationRequest_RejectImpl _self _arg =
        pure (ChoiceExecutionMetadata with meta = emptyMetadata)
      allocationRequest_WithdrawImpl _self _arg =
        pure (ChoiceExecutionMetadata with meta = emptyMetadata)
      view = AllocationRequestView with
        settlement = SettlementInfo with
          executor = operator
          settlementRef = Reference with
            -- `epoch` fallbacks are deliberately IN THE PAST. A pre-upgrade proposal
            -- carries no deadlines, and a wallet must read that as already expired and
            -- refuse, rather than as an open-ended settlement it may sign at any time.
            -- Failing closed is the only safe reading of a missing deadline.
            id = fromOptional "legacy-no-trade-id" tradeId
            cid = None
          requestedAt = fromOptional epoch requestedAt
          allocateBefore = fromOptional epoch allocateBefore
          settleBefore = fromOptional epoch settleBefore
          meta = emptyMetadata
        transferLegs = TextMap.fromList
          [ ( "offer"
            , TransferLeg with
                sender = requester
                receiver = dealer
                amount = offerAmount
                instrumentId = InstrumentId with
                  admin = offerAsset.admin
                  id = offerAsset.symbol
                meta = emptyMetadata )
          , ( "want"
            , TransferLeg with
                sender = dealer
                receiver = requester
                amount = price
                instrumentId = InstrumentId with
                  admin = wantAsset.admin
                  id = wantAsset.symbol
                meta = emptyMetadata )
          ]
        meta = emptyMetadata

template RealSwapPending
  with
    requester    : Party
    operator     : Party
    dealer       : Party
    offerAsset   : AssetId
    offerAmount  : Decimal
    wantAsset    : AssetId
    price        : Decimal
    offerAllocCid : ContractId Allocation
    wantAllocCid  : ContractId Allocation
    refMid        : Optional Decimal
    feeParty      : Optional Party
    feeAmount     : Optional Decimal
    feeAllocCid   : Optional (ContractId Allocation)
  where
    signatory requester
    observer dealer, operator

    choice AcceptRealSwap : ContractId SwapSettlement
      controller dealer
      do
        create SwapSettlement with
          requester; operator; dealer
          offerAsset; offerAmount; wantAsset; price
          refMid
          offerAllocCid; wantAllocCid
          feeParty; feeAmount; feeAllocCid
          settledVia = "real"

    -- Requester can withdraw the proposal if the dealer never accepts.
    choice WithdrawRealSwap : ()
      controller requester
      do pure ()


template SwapDealerPending
  with
    requester    : Party
    operator     : Party
    dealer       : Party
    offerAsset   : AssetId
    offerAmount  : Decimal
    wantAsset    : AssetId
    price        : Decimal
    offerAllocCid : ContractId Allocation   -- v6: interface cid (stand-in or real)
  where
    signatory requester
    observer dealer, operator

    -- Dealer commits its want leg. Now both allocations exist; the dealer's
    -- acceptance gathers dealer authority onto the settlement.
    choice CommitDealerLeg : ContractId SwapSettlement
      with
        dealerHoldingCid : ContractId AssetHolding
        -- The market reference at the moment of commit. Optional and honest:
        -- None when the pair has no public price (CC) or the feed is down. We
        -- record the absence rather than invent a mark.
        refMid : Optional Decimal
      controller dealer
      do
        wantAllocRaw <- create AssetAllocation with
          sender = dealer; receiver = requester; executor = operator
          asset = wantAsset; amount = price
          holdingCid = dealerHoldingCid; legId = "want-leg"
        create SwapSettlement with
          requester; operator; dealer
          offerAsset; offerAmount; wantAsset; price
          refMid
          offerAllocCid
          wantAllocCid = toInterfaceContractId @Allocation wantAllocRaw
          -- The stand-in path never touches a registry and charges nothing.
          feeParty = None
          feeAmount = None
          feeAllocCid = None
          settledVia = "standin"


-- Signed by requester AND dealer (via the chain of accepts) -- so ExecuteSwap,
-- controlled by the operator/executor, carries all the authority the nested
-- Allocation_ExecuteTransfer on each leg requires.
template SwapSettlement
  with
    requester    : Party
    operator     : Party
    dealer       : Party
    -- The trade, on the record. Previously the settlement held only pointers to
    -- two allocations, which are consumed on execution -- so a settled swap left
    -- no readable trace of WHAT was traded. The book needs this.
    offerAsset   : AssetId
    offerAmount  : Decimal
    wantAsset    : AssetId
    price        : Decimal
    refMid       : Optional Decimal
    -- v6: allocation references are stored as the Allocation INTERFACE cid, so a
    -- settlement can reference EITHER the venue's own AssetAllocation (stand-in) OR
    -- a registry-issued DvpLegAllocation (real cBTC/cETH/CC). The concrete template
    -- differs; the interface is the same. Execution of real legs is performed by the
    -- backend (it must supply the registry choice-context + disclosures, which Daml
    -- cannot fetch), so for real swaps this is the on-ledger TRADE RECORD and the
    -- audit pointer to the two real allocations.
    offerAllocCid : ContractId Allocation
    wantAllocCid  : ContractId Allocation
    -- "standin" = executable on-ledger via ExecuteSwap; "real" = executed by the
    -- backend against the registry, recorded here for audit.
    settledVia   : Text
    -- The venue's cut, and the third allocation that pays it. Settled in the SAME
    -- transaction as the two trade legs, so the fee cannot succeed while the trade
    -- fails, or the reverse.
    -- These sit LAST on purpose: a Daml upgrade may only append fields, so inserting
    -- them above settledVia reordered the record and the participant refused the
    -- package outright ("changed the order of its fields").
    feeParty      : Optional Party
    feeAmount     : Optional Decimal
    feeAllocCid   : Optional (ContractId Allocation)
  where
    signatory requester, dealer
    observer operator

    -- Fire both legs in one indivisible transaction (STAND-IN path only). The
    -- venue's own AssetAllocation needs no registry context, so emptyChoiceContext
    -- suffices. Real allocations require the registry context and are executed by
    -- the backend /api/real/settle instead. Guarded so it can't be misused on real.
    choice ExecuteSwap : ()
      controller operator
      do
        assertMsg "ExecuteSwap is for stand-in settlements; real legs settle via the registry"
          (settledVia == "standin")
        let ea = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
        _ <- exercise offerAllocCid Allocation_ExecuteTransfer with extraArgs = ea
        _ <- exercise wantAllocCid Allocation_ExecuteTransfer with extraArgs = ea
        pure ()

    -- v7 REAL path: one-command, all-signed atomic settle for registry tokens.
    -- Signed by requester+dealer, controlled by operator, so the single exercise
    -- carries every authority the nested Allocation_ExecuteTransfer needs. The
    -- backend fetches each leg's registry choice-context (Daml can't) and passes
    -- them in as offerArgs/wantArgs, and supplies the merged disclosed contracts
    -- at submission. Both legs move in THIS one transaction -> atomic, and it's a
    -- single command so an external wallet can sign it via interactive-submission.
    choice ExecuteRealSwap : ()
      with
        offerArgs : ExtraArgs
        wantArgs  : ExtraArgs
        feeArgs   : Optional ExtraArgs
      controller operator
      do
        assertMsg "ExecuteRealSwap is for real settlements"
          (settledVia == "real")
        -- A fee that was agreed must actually be paid. Without this the operator could
        -- execute the trade and quietly drop the fee leg -- or, more importantly, a
        -- settlement could be assembled that looks fee-bearing but is not.
        let feePresent = case (feeAmount, feeAllocCid) of
              (Some a, None) -> a <= 0.0
              _ -> True
        assertMsg "a fee was agreed but no fee allocation was supplied" feePresent
        _ <- exercise offerAllocCid Allocation_ExecuteTransfer with extraArgs = offerArgs
        _ <- exercise wantAllocCid Allocation_ExecuteTransfer with extraArgs = wantArgs
        -- Third leg, same transaction. All three move or none do.
        case (feeAllocCid, feeArgs) of
          (Some fc, Some fa) -> do
            _ <- exercise fc Allocation_ExecuteTransfer with extraArgs = fa
            pure ()
          _ -> pure ()
        pure ()

    -- Either principal can abort before execution; both allocations are then
    -- withdrawn by their senders out-of-band.
    choice AbortSwap : ()
      controller requester
      do pure ()


-- ----------------------------------------------------------------------------
-- Standing mandate (the Daml "delegation" pattern)
-- ----------------------------------------------------------------------------
-- A party signs this ONCE, and the venue may afterwards perform the BOOKKEEPING
-- steps of that party's trades on its behalf. It can never perform the steps that
-- commit value.
--
-- Why this exists. Opening a request cost the requester 1 + N signatures, one per
-- dealer invited, because InviteDealer needs the RFQ's contract id and that does not
-- exist until the create has committed. At a hundred dealers that is a hundred and
-- one wallet prompts to ask a single question. Batching it into one submission is not
-- available either: interactive submission -- the path every bring-your-own-wallet
-- party signs through -- rejects a transaction with more than one root node, and a
-- create plus an exercise is two. Exercising a choice on a contract that ALREADY
-- exists is one root node, so a mandate is the only shape that works.
--
-- The precedent is Canton's own. Splice.Wallet.TransferPreapproval exists so that an
-- external party can receive Canton Coin without signing for every transfer; this is
-- the same trade, applied to steps that move nothing.
--
-- WHAT THE OPERATOR CAN DO under a mandate:
--   * open a request and invite the dealers named on it
--   * propose settlement of a swap whose price and legs are already fixed
--   * accept a pending swap whose terms this party already committed to
-- WHAT IT STILL CANNOT DO -- these choices are simply absent, not merely discouraged:
--   * allocate or move this party's funds
--   * accept a price on this party's behalf
--   * quote a price on this party's behalf
--   * anything at all once `expiresAt` has passed, or after RevokeMandate
template TradingMandate
  with
    party     : Party    -- the requester or dealer granting the mandate
    operator  : Party
    expiresAt : Time     -- a mandate is a session, not a standing grant
  where
    signatory party
    observer operator

    -- Open a request AND invite every dealer on it, in one transaction.
    nonconsuming choice MandateOpenRfq : (ContractId SwapRfq, [ContractId SwapInvitation])
      with
        mOfferAsset  : AssetId
        mOfferAmount : Decimal
        mWantAsset   : AssetId
        mInvited     : [Party]
        mExpiresAt   : Time
      controller operator
      do
        now <- getTime
        assertMsg "this mandate has expired" (now < expiresAt)
        assertMsg "a request must offer and want different assets" (mOfferAsset /= mWantAsset)
        rfq <- create SwapRfq with
          requester = party; operator
          offerAsset = mOfferAsset; offerAmount = mOfferAmount
          wantAsset = mWantAsset; invited = mInvited
          expiresAt = mExpiresAt
        invs <- forA mInvited (\d ->
          create SwapInvitation with
            requester = party; operator; dealer = d
            offerAsset = mOfferAsset; offerAmount = mOfferAmount
            wantAsset = mWantAsset; expiresAt = mExpiresAt
            rfqCid = rfq)
        pure (rfq, invs)

    -- Propose settlement of a swap this party already accepted and allocated for.
    -- Moves nothing: the price was fixed by AcceptSwapQuote and both legs were
    -- allocated by their own owners' signatures.
    nonconsuming choice MandateProposeRealSwap : ContractId RealSwapPending
      with
        mProposalCid : ContractId SwapProposal
        mOfferAlloc  : ContractId Allocation
        mWantAlloc   : ContractId Allocation
        mRefMid      : Optional Decimal
        mFeeAlloc    : Optional (ContractId Allocation)
      controller operator
      do
        now <- getTime
        assertMsg "this mandate has expired" (now < expiresAt)
        prop <- fetch mProposalCid
        -- A mandate speaks for ONE party. Without this it would let the operator drive
        -- any proposal it could see, using an unrelated party's grant as the authority.
        assertMsg "this proposal does not belong to the mandating party"
          (prop.requester == party)
        exercise mProposalCid ProposeRealSwap with
          realOfferAllocCid = mOfferAlloc
          realWantAllocCid = mWantAlloc
          realRefMid = mRefMid
          realFeeAllocCid = mFeeAlloc

    -- Accept a pending swap this party is the dealer on, on terms it already quoted.
    nonconsuming choice MandateAcceptRealSwap : ContractId SwapSettlement
      with
        mPendingCid : ContractId RealSwapPending
      controller operator
      do
        now <- getTime
        assertMsg "this mandate has expired" (now < expiresAt)
        pend <- fetch mPendingCid
        assertMsg "this pending swap does not belong to the mandating party"
          (pend.dealer == party)
        exercise mPendingCid AcceptRealSwap

    -- Withdrawable at any moment, by the party alone.
    choice RevokeMandate : ()
      controller party
      do pure ()


-- Convenience helper for tooling: is an asset listed in a registry snapshot?
isListed : [AssetId] -> AssetId -> Bool
isListed assets a = isSome (find (== a) assets)
