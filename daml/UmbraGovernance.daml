-- Put multi-sig on the venue's privileged actions.
--
-- Umbra's operator can list and delist assets, decide who may see the registry,
-- and approve the execution path of a settled trade. Every one of those is
-- `controller operator` in UmbraSwap, which means one key decides all of them.
-- That is the single point of control a decentralized party is meant to remove.
--
-- Each template here wraps ONE of those choices as a proposal. The proposal is
-- inert on its own: GovernableAction_Execute is `controller governanceParty`,
-- so nothing happens until the Decentralization Manager has collected enough
-- confirmations and exercises it with the governance party's authority.
--
-- THE ONE CONSTRAINT THAT DECIDES WHETHER THIS WORKS: executeImpl runs with the
-- governance party's authority and nothing else. So the venue's `operator` must
-- BE the governance party -- the AssetRegistry's operator field and
-- governanceParty here are the same Party. Point this at a registry owned by
-- someone else and the exercise fails for want of authority, which is the
-- failure the briefing warns custom actions hit first.
--
-- The proposer signs the proposal and can retract it alone
-- (GovernableAction_ProposerCancel); only governance can execute it.
module UmbraGovernance where

import Governance.Action
import Splice.Api.Token.MetadataV1
import UmbraSwap

-- | Bring the registry into existence under governance.
--
-- There is a bootstrapping problem otherwise: AssetRegistry is `signatory
-- operator`, and once the operator is the decentralized party, nobody holds a
-- key that can create it. The Decentralization Manager's own contract-deployment
-- API cannot do it either -- its field encoding has no list type at all (single
-- parties, scalars, Set, record, optional; `party_set` is explicitly a
-- DA.Set.Types:Set, not a list), so a template with `participants : [Party]` and
-- `assets : [AssetId]` cannot be expressed there.
--
-- A proposal sidesteps both. THIS contract is `signatory proposer`, so the venue
-- creates it with its own key and no governance authority at all; the registry it
-- creates is signed by the governance party, because executeImpl runs with that
-- authority once the operators have confirmed. So the registry is governed from
-- the moment it exists, and was never owned by one key even briefly.
template CreateRegistryProposal
  with
    governanceParty : Party
    proposer        : Party
    participants    : [Party]
  where
    signatory proposer
    observer governanceParty

    interface instance GovernableAction for CreateRegistryProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "CreateAssetRegistry"
        description = "Create the venue's asset registry, governed, visible to "
                   <> show (length participants) <> " participants"

      executeImpl = do
        _ <- create AssetRegistry with
          operator = governanceParty
          participants
          assets = []
        pure ()

-- | List an asset on the venue. The pair goes live only once the operators agree.
template ListAssetProposal
  with
    governanceParty : Party                      -- the registry's operator
    proposer        : Party
    registryCid     : ContractId AssetRegistry
    asset           : AssetId
  where
    signatory proposer
    observer governanceParty

    interface instance GovernableAction for ListAssetProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "ListAsset"
        description = "List " <> asset.symbol <> " as tradeable on the venue"

      executeImpl = do
        _ <- exercise registryCid ListAsset with asset
        pure ()

-- | Remove an asset from the tradeable set. Delisting strands anyone mid-trade
-- in that pair, so it is exactly as privileged as listing.
template DelistAssetProposal
  with
    governanceParty : Party
    proposer        : Party
    registryCid     : ContractId AssetRegistry
    asset           : AssetId
  where
    signatory proposer
    observer governanceParty

    interface instance GovernableAction for DelistAssetProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "DelistAsset"
        description = "Remove " <> asset.symbol <> " from the tradeable set"

      executeImpl = do
        _ <- exercise registryCid DelistAsset with asset
        pure ()

-- | Change who may observe the registry. This is the venue's membership list:
-- adding a party lets it see what is tradeable, removing one cuts it off. A
-- single operator being able to do that quietly is the reason it is here.
template SetParticipantsProposal
  with
    governanceParty : Party
    proposer        : Party
    registryCid     : ContractId AssetRegistry
    participants    : [Party]
  where
    signatory proposer
    observer governanceParty

    interface instance GovernableAction for SetParticipantsProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "SetParticipants"
        description = "Set the registry's participant list to "
                   <> show (length participants) <> " parties"

      executeImpl = do
        _ <- exercise registryCid SetParticipants with participants' = participants
        pure ()

-- | Settle a block trade only when a threshold of operators agrees.
--
-- This is the one that matters. The three above govern configuration; this
-- governs money moving. ExecuteRealSwap is `controller operator` and fires both
-- allocation legs plus the fee in a single transaction, so the operator key that
-- can call it can also decline to -- holding a settled trade hostage, or picking
-- which counterparty gets filled. A threshold removes that.
--
-- WHY THE TRADE IS DESCRIBED ON THE PROPOSAL RATHER THAN READ FROM THE
-- SETTLEMENT: the interface view is a pure function, so it cannot fetch. A
-- proposal that carried only a ContractId would show each operator an opaque
-- hash and ask them to approve it, which is not approval, it is a rubber stamp.
-- So the trade is summarised on the proposal where the view can reach it.
--
-- That summary is not taken on trust. executeImpl fetches the settlement and
-- asserts the summary matches before exercising anything, so a proposer who
-- describes a small trade and points at a large one fails at execution rather
-- than succeeding quietly. The operators approve what they read.
template ExecuteRealSwapProposal
  with
    governanceParty : Party                          -- the settlement's operator
    proposer        : Party
    settlementCid   : ContractId SwapSettlement
    -- Denormalised purely so the view can render it; checked on execute.
    offerSymbol     : Text
    offerAmount     : Decimal
    wantSymbol      : Text
    -- Registry choice-context, built off-ledger by the venue. Daml cannot
    -- assemble these itself, which is why they are supplied rather than derived.
    offerArgs       : ExtraArgs
    wantArgs        : ExtraArgs
    feeArgs         : Optional ExtraArgs
  where
    signatory proposer
    observer governanceParty

    interface instance GovernableAction for ExecuteRealSwapProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "ExecuteRealSwap"
        description = "Settle " <> show offerAmount <> " " <> offerSymbol
                   <> " for " <> wantSymbol <> " - both legs, one transaction"

      executeImpl = do
        s <- fetch settlementCid
        assertMsg
          ("the settlement does not match the approved summary: expected "
            <> show offerAmount <> " " <> offerSymbol <> " for " <> wantSymbol)
          (s.offerAsset.symbol == offerSymbol
            && s.offerAmount == offerAmount
            && s.wantAsset.symbol == wantSymbol)
        exercise settlementCid ExecuteRealSwap with offerArgs, wantArgs, feeArgs

-- | Stop routing flow to a desk. This is the venue telling a counterparty it is
-- no longer welcome, which is a reputational act with money behind it -- exactly
-- the kind of decision that should not rest on one operator having a bad day, or
-- on one operator quietly favouring a competitor by suspending it.
--
-- The dealer is an observer of the suspension it creates, so the desk can read
-- the stated reason off the ledger rather than being told nothing. A file on the
-- venue's disk could never offer that.
template SuspendDealerProposal
  with
    governanceParty : Party        -- the venue; signs the suspension
    proposer        : Party
    dealer          : Party
    reason          : Text
  where
    signatory proposer
    observer governanceParty

    interface instance GovernableAction for SuspendDealerProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "SuspendDealer"
        description = "Stop routing flow to this desk - " <> reason

      executeImpl = do
        now <- getTime
        _ <- create DealerSuspension with
          operator = governanceParty
          dealer; reason
          since = now
        pure ()

-- | And the way back. Reinstating is as privileged as suspending: a single key
-- able to lift a suspension the operators agreed on would make the threshold
-- decorative.
template LiftSuspensionProposal
  with
    governanceParty : Party
    proposer        : Party
    suspensionCid   : ContractId DealerSuspension
    dealer          : Party        -- denormalised so the view can name the desk
  where
    signatory proposer
    observer governanceParty

    interface instance GovernableAction for LiftSuspensionProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "LiftSuspension"
        description = "Reinstate a suspended desk and route flow to it again"

      executeImpl = do
        s <- fetch suspensionCid
        -- Same discipline as ExecuteRealSwapProposal: the summary an operator
        -- approved has to match the contract being acted on, or a proposal
        -- could name one desk and reinstate another.
        assertMsg "the suspension does not match the approved summary"
          (s.dealer == dealer)
        exercise suspensionCid LiftSuspension
